{
  "manifest_version": 3,
  "name": "Chounter",
  "description": "Character counter. Returns number of characters pasted into text area.",
  "version": "1.0",
  "author": "Goran Grbic",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "128.png",
      "48": "128.png",
      "128": "128.png"
    }
  },
  "icons": {
    "16": "128.png",
    "48": "128.png",
    "128": "128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "permissions": []
}
