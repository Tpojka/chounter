{
  "manifest_version": 3,
  "name": "Chounter",
  "description": "Character counter. Returns number of characters pasted into text area.",
  "version": "1.0",
  "author": "Goran Grbic",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
